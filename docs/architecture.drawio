        </mxCell>
        <mxCell id="subtitle" value="Ubuntu Server 26.04 ARM64 · UTM Shared Network · Nginx → Gunicorn → Flask → PostgreSQL" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="820" height="20" as="geometry" />
