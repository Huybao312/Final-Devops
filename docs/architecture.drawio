        <mxCell id="utm" value="UTM Shared Network — 192.168.64.0/24 (NAT)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="270" y="110" width="880" height="600" as="geometry" />
        </mxCell>
