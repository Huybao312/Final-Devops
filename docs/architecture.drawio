          <mxGeometry x="310" y="160" width="810" height="520" as="geometry" />
        </mxCell>

        <mxCell id="ufw" value="&lt;b&gt;UFW firewall&lt;/b&gt;&lt;br&gt;allow 22/tcp (SSH)&lt;br&gt;allow 80/tcp (HTTP)&lt;br&gt;deny everything else" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="220" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="nginx" value="&lt;b&gt;Nginx :80&lt;/b&gt;&lt;br&gt;reverse proxy&lt;br&gt;server_tokens off&lt;br&gt;security headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="220" width="200" height="90" as="geometry" />
        </mxCell>

        <mxCell id="gunicorn" value="&lt;b&gt;Gunicorn 127.0.0.1:5000&lt;/b&gt;&lt;br&gt;Flask 3.1.3&lt;br&gt;3 workers&lt;br&gt;user: www-data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="570" y="370" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="postgres" value="&lt;b&gt;PostgreSQL 127.0.0.1:5432&lt;/b&gt;&lt;br&gt;database: todo&lt;br&gt;role: todo_app (DML only)&lt;br&gt;owner: todo_owner (NOLOGIN)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="370" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="&lt;b&gt;Persistent storage&lt;/b&gt;&lt;br&gt;/var/lib/postgresql&lt;br&gt;UTM virtual disk" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="865" y="540" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="env" value="&lt;b&gt;/etc/todo-task-manager.env&lt;/b&gt;&lt;br&gt;DATABASE_URL&lt;br&gt;root:root, mode 0600&lt;br&gt;not committed to Git" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="390" width="180" height="110" as="geometry" />
        </mxCell>

        <mxCell id="osnote" value="&lt;b&gt;Host:&lt;/b&gt; Ubuntu Server 26.04 ARM64 · 2 vCPU / 4 GB RAM / 20 GB disk&lt;br&gt;&lt;b&gt;App:&lt;/b&gt; /opt/todo-task-manager · Python venv · systemd unit flaskapp&lt;br&gt;&lt;b&gt;Rule:&lt;/b&gt; 5000 and 5432 bind to 127.0.0.1 only — never exposed to the UTM network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="540" width="470" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e-client-nginx" value="HTTP :80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e79;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="client" target="nginx">
