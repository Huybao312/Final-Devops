        <mxCell id="e-gunicorn-postgres" value="TCP 5432&lt;br&gt;loopback only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gunicorn" target="postgres">
