        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;Admin (macOS)&lt;/b&gt;&lt;br&gt;Terminal / SSH&lt;br&gt;scripts, logs, backup" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="190" height="110" as="geometry" />
